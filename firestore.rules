rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdminOfCompany(companyId) {
      return isAuthenticated() &&
             getUserData().role == 'admin' &&
             getUserData().companyId == companyId;
    }

    function isMemberOfCompany(companyId) {
      return isAuthenticated() &&
             getUserData().companyId == companyId;
    }

    // 1. attendances: Prohibida la escritura directa a clientes.
    match /attendances/{attendanceId} {
      allow create, update, delete: if false;
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdminOfCompany(resource.data.companyId)
      );
    }

    // 2. idempotency_keys: Acceso cliente denegado al 100%. Solo Admin SDK.
    match /idempotency_keys/{keyId} {
      allow read, write: if false;
    }

    // 3. users: Perfiles de usuario y restricciones de modificación
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdminOfCompany(resource.data.companyId)
      );

      allow create: if isAuthenticated() &&
        request.resource.data.role == 'employee' &&
        isAdminOfCompany(request.resource.data.companyId);

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken', 'phone', 'image'])) ||
        (isAdminOfCompany(resource.data.get('companyId', '')) &&
         resource.data.get('role', '') == 'employee' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['companyId', 'role', 'uid', 'email']))
      );

      allow delete: if isAdminOfCompany(resource.data.companyId) && resource.data.role != 'admin';
    }

    // 4. companies y subcolecciones (shifts, sedes)
    match /companies/{companyId} {
      allow read: if isMemberOfCompany(companyId);
      allow create, delete: if false;
      // Eliminado 'shifts' (es subcolección) y 'geoFence' (se usan sedes). Campos editables en raíz: name, horaEntrada, toleranciaMin
      allow update: if isAdminOfCompany(companyId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'horaEntrada', 'toleranciaMin']);

      match /shifts/{shiftId} {
        allow read: if isMemberOfCompany(companyId);
        allow create, update: if isAdminOfCompany(companyId) &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 &&
          request.resource.data.startTime is string && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
          request.resource.data.endTime is string && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') &&
          request.resource.data.toleranceMin is number && request.resource.data.toleranceMin >= 0 && request.resource.data.toleranceMin <= 120;
        allow delete: if isAdminOfCompany(companyId);
      }

      match /sedes/{sedeId} {
        allow read: if isMemberOfCompany(companyId);
        allow create, update: if isAdminOfCompany(companyId) &&
          request.resource.data.nombre is string && request.resource.data.nombre.size() > 0 &&
          request.resource.data.lat is number && request.resource.data.lat >= -90.0 && request.resource.data.lat <= 90.0 &&
          request.resource.data.lng is number && request.resource.data.lng >= -180.0 && request.resource.data.lng <= 180.0 &&
          request.resource.data.radioMetros is number && request.resource.data.radioMetros >= 20 && request.resource.data.radioMetros <= 500 &&
          request.resource.data.activa is bool;
        allow delete: if isAdminOfCompany(companyId);
      }
    }

    // 5. notifications: Lectura EXCLUSIVA para Administradores de la misma empresa
    match /notifications/{notificationId} {
      allow read: if isAdminOfCompany(resource.data.companyId);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
