# Parameters read by defineInt() in functions/src/index.ts.
# Firestore/Functions emulators load functions/.env at startup; the Dockerfile
# copies this file to functions/.env inside the image (the repo copy stays clean).
#
# MAX_ACCURACY_METERS is intentionally NOT the hardcoded default (50) so the
# smoke test can prove the value is coming from the environment: accuracy 47
# must be rejected, which only happens when this file is actually loaded.
MAX_ACCURACY_METERS=45
EARLY_CHECKIN_MINUTES=60
MIN_MINUTES_BEFORE_CHECKOUT=5
MAX_CHECKOUT_OVERTIME_MINUTES=120
IDEMPOTENCY_TTL_DAYS=7
